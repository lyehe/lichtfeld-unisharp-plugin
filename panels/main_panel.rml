<rml>
<head>
  <link type="text/rcss" href="main_panel.rcss"/>
</head>
<body data-model="unisharp">
<div id="content-wrap">
<div id="content">

  <span class="panel-title text-accent">UniSHARP</span>
  <span class="panel-subtitle text-muted">Turn one universal-camera image into a 3D Gaussian splat.</span>

  <div class="model-banner" data-if="model_downloading">
    <span class="status-line text-accent">{{model_status_line}}</span>
    <div class="progress-wrap">
      <progress class="job-progress" max="1" data-attr-value="prep_progress_value"></progress>
      <span class="progress-text">{{prep_progress_pct}} {{prep_bytes_line}}</span>
    </div>
  </div>
  <div class="model-banner banner-warn" data-if="model_error">
    <span class="status-error">Asset preparation failed</span>
    <span class="error-detail text-default">{{prep_error_text}}</span>
    <button class="btn btn--warning btn--full" data-event-click="retry_download">Retry</button>
  </div>

  <span class="section-title text-accent">Step 1 &#183; Image</span>
  <div class="button-row">
    <button class="btn btn--default" data-event-click="browse_image">Choose image&#8230;</button>
    <button class="btn btn--default" data-event-click="paste_image" data-attrif-disabled="!can_paste">Paste</button>
  </div>
  <span class="help-text text-muted">{{image_name}}</span>

  <div class="separator"></div>
  <span class="section-title text-accent">Step 2 &#183; Camera</span>
  <div class="setting-row"><span class="prop-label">Mode</span>
    <select data-value="camera_mode">
      <option value="auto">Auto</option>
      <option value="perspective">Perspective</option>
      <option value="panorama">Panorama</option>
      <option value="fisheye">Fisheye</option>
    </select></div>

  <div class="section-header" data-event-click="toggle_section('calibration')">
    <span class="section-arrow" id="arrow-calibration">&#x25B6;</span><span>Calibration</span>
  </div>
  <div class="section-content collapsed" id="sec-calibration">
    <div class="button-row">
      <button class="btn btn--default" data-event-click="browse_camera_json">Camera JSON&#8230;</button>
      <button class="btn btn--default" data-event-click="clear_camera_json">Clear</button>
    </div>
    <span class="help-text text-muted">{{camera_json_name}}</span>
    <div class="setting-row"><span class="prop-label">Intrinsics</span>
      <input type="text" data-value="camera_intrinsics"/></div>
    <span class="help-text text-muted">fx fy cx cy, or 9 K values.</span>
    <div class="setting-row"><span class="prop-label">Fisheye624</span>
      <input type="text" data-value="camera_params"/></div>
    <span class="help-text text-muted">8 or 16 fisheye parameters.</span>
    <div class="setting-row"><span class="prop-label">Low pass</span>
      <input type="range" class="setting-slider" data-value="low_pass_filter_eps" min="0" max="0.10" step="0.005"/>
      <span class="slider-value">{{low_pass_filter_eps}}</span></div>
  </div>

  <div class="separator"></div>
  <span class="section-title text-accent">Step 3 &#183; Generate</span>
  <span class="help-text text-muted">{{model_status_line}}</span>
  <span class="help-text text-muted">{{dependency_status_line}}</span>
  <div class="setting-row">
    <label class="setting-label"><input type="checkbox" data-checked="append_mode"/><span>Append (keep previous objects)</span></label>
  </div>
  <div class="setting-row"><span class="prop-label">Splat scale</span>
    <input type="range" class="setting-slider" data-value="splat_scale" min="0.25" max="4.0" step="0.05"/>
    <span class="slider-value">{{splat_scale}}</span></div>

  <div data-if="show_idle">
    <button class="btn btn--success btn--full action-btn" data-event-click="do_start" data-attrif-disabled="!can_run">Generate</button>
    <button class="btn btn--default btn--full action-btn" data-event-click="generate_from_clipboard" data-attrif-disabled="!can_gen_clipboard">Generate from clipboard</button>
    <div class="button-row" data-if="model_loaded">
      <button class="btn btn--default btn--full" data-event-click="unload_model">Free VRAM</button>
    </div>
  </div>
  <div data-if="show_running">
    <span class="status-line text-default">Stage: {{stage_text}}</span>
    <div class="progress-wrap">
      <progress class="job-progress" max="1" data-attr-value="progress_value"></progress>
      <span class="progress-text">{{progress_pct}}</span>
    </div>
    <span class="help-text text-muted">{{progress_status}}</span>
    <button class="btn btn--warning btn--full action-btn" data-event-click="do_cancel">Cancel</button>
  </div>
  <div data-if="show_results">
    <span class="result-line text-muted">{{result_count}} gaussians &#183; {{result_camera}} &#183; {{result_time}}</span>
    <span class="help-text text-muted">{{result_output_dir}}</span>
  </div>
  <div data-if="show_error">
    <span class="status-error">Error</span>
    <span class="error-detail text-default">{{error_text}}</span>
  </div>
  <div data-if="show_logs">
    <div class="log-box"><span class="log-output">{{live_log_text}}</span></div>
  </div>

  <div data-if="has_node">
    <div class="separator"></div>
    <span class="section-title text-accent">Step 4 &#183; Place</span>
    <span class="help-text text-muted">Editing {{edit_target}}</span>
    <div class="button-row" data-if="gizmo_active">
      <button class="btn" data-class-btn--success="is_translate" data-class-btn--default="!is_translate" data-event-click="set_gizmo_mode('translate')">Move</button>
      <button class="btn" data-class-btn--success="is_rotate" data-class-btn--default="!is_rotate" data-event-click="set_gizmo_mode('rotate')">Rotate</button>
      <button class="btn" data-class-btn--success="is_scale" data-class-btn--default="!is_scale" data-event-click="set_gizmo_mode('scale')">Scale</button>
    </div>
    <div class="setting-row"><span class="prop-label">Scale</span>
      <input type="text" data-value="scl"/></div>
    <div class="button-row">
      <button class="btn btn--success btn--full" data-event-click="finalize_placement" data-if="gizmo_active">Done placing</button>
      <button class="btn btn--default btn--full" data-event-click="start_placement" data-if="!gizmo_active">Adjust placement</button>
    </div>
    <div class="section-header" data-event-click="toggle_section('precise')">
      <span class="section-arrow" id="arrow-precise">&#x25B6;</span><span>Precise</span>
    </div>
    <div class="section-content collapsed" id="sec-precise">
      <div class="setting-row"><span class="prop-label">Pos X/Y/Z</span>
        <input type="text" data-value="tx"/><input type="text" data-value="ty"/><input type="text" data-value="tz"/></div>
      <div class="setting-row"><span class="prop-label">Rot X/Y/Z</span>
        <input type="text" data-value="rx"/><input type="text" data-value="ry"/><input type="text" data-value="rz"/></div>
    </div>
  </div>

</div>
</div>
</body>
</rml>
